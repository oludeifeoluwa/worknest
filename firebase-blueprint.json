{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public sector officer or staff member profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "emailDomain": { "type": "string", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Member", "Guest"] },
        "status": { "type": "string", "enum": ["online", "busy", "offline"] },
        "department": { "type": "string", "maxLength": 128 },
        "jobTitle": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "isVerifiedGov": { "type": "boolean" },
        "approvalStatus": { "type": "string", "enum": ["approved", "pending_approval", "rejected"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "approvalStatus"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Public or restricted council / department channel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 80 },
        "topic": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["Organization", "Projects", "Departments"] },
        "isPrivate": { "type": "boolean" },
        "organizationId": { "type": "string", "maxLength": 128 },
        "members": { "type": "array" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "unreadCount": { "type": "number" }
      },
      "required": ["id", "name", "category", "isPrivate"]
    },
    "Message": {
      "title": "Message",
      "description": "Deliberation or directive message in a channel or direct line.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sender": { "type": "object" },
        "content": { "type": "string", "maxLength": 5000 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "reactions": { "type": "array" },
        "attachments": { "type": "array" },
        "voiceNote": { "type": "object" },
        "sharedEmailRef": { "type": "object" },
        "isPinned": { "type": "boolean" },
        "replies": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "content", "sender"]
    },
    "FileItem": {
      "title": "FileItem",
      "description": "Statutory document or gazette item metadata in the secure repository.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "enum": ["document", "image", "spreadsheet", "presentation", "code", "pdf", "archive"] },
        "size": { "type": "string", "maxLength": 64 },
        "storagePath": { "type": "string", "maxLength": 500 },
        "downloadUrl": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "object" },
        "folderId": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array" },
        "securityClassification": { "type": "string", "enum": ["Official", "Confidential", "Restricted", "Public"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "size", "updatedBy"]
    },
    "EmailMessage": {
      "title": "EmailMessage",
      "description": "Official government dispatch email.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sender": { "type": "object" },
        "to": { "type": "array" },
        "cc": { "type": "array" },
        "subject": { "type": "string", "maxLength": 300 },
        "snippet": { "type": "string", "maxLength": 300 },
        "body": { "type": "string", "maxLength": 10000 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 64 },
        "folder": { "type": "string", "enum": ["inbox", "starred", "sent", "drafts", "archive", "trash"] },
        "isRead": { "type": "boolean" },
        "isStarred": { "type": "boolean" },
        "isImportant": { "type": "boolean" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "subject", "folder", "sender"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Tamper-evident statutory audit log entry for NDPA 2023 compliance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actor": { "type": "object" },
        "action": { "type": "string", "maxLength": 128 },
        "target": { "type": "string", "maxLength": 256 },
        "details": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["success", "flagged"] },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "actor", "action", "target"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "User notification for directives, mentions, or official dispatches.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 300 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "isRead": { "type": "boolean" },
        "type": { "type": "string", "enum": ["mention", "message", "email", "event", "system"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["channel", "dm", "email", "event"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "isRead", "type"]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Kanban project task deliverable and assignment item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "review", "done"] },
        "priority": { "type": "string", "enum": ["urgent", "high", "medium", "low"] },
        "dueDate": { "type": "string", "maxLength": 32 },
        "dueTime": { "type": "string", "maxLength": 16 },
        "assigneeIds": { "type": "array" },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 128 },
        "tags": { "type": "array" },
        "deliverableId": { "type": "string", "maxLength": 128 },
        "deliverableTitle": { "type": "string", "maxLength": 200 },
        "channelId": { "type": "string", "maxLength": 128 },
        "channelName": { "type": "string", "maxLength": 128 },
        "checklist": { "type": "array" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "status", "priority", "dueDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and officer directory data"
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "Council and Department channels"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Deliberations, chat messages, and directives"
    },
    "/files/{fileId}": {
      "schema": "FileItem",
      "description": "Secure document vault metadata and gazettes"
    },
    "/emails/{emailId}": {
      "schema": "EmailMessage",
      "description": "Official government dispatches"
    },
    "/tasks/{taskId}": {
      "schema": "TaskItem",
      "description": "Project task board assignments and deliverables"
    },
    "/auditLogs/{auditId}": {
      "schema": "AuditLogEntry",
      "description": "NDPA 2023 statutory audit trail records"
    },
    "/notifications/{notificationId}": {
      "schema": "NotificationItem",
      "description": "Real-time officer alerts and notifications"
    },
    "/organizations/{orgId}": {
      "schema": "User",
      "description": "Organization institutional settings and domain allowlists"
    }
  }
}
