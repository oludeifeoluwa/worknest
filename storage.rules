rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Common Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidSize(maxBytes) {
      return request.resource == null || request.resource.size <= maxBytes;
    }

    // 1. Organization Documents & Statutory Assets
    match /organizations/{orgId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize(50 * 1024 * 1024);
      allow delete: if isAuthenticated();
    }

    // 2. Files & Statutory Gazettes Repository
    match /files/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize(50 * 1024 * 1024);
      allow delete: if isAuthenticated();
    }

    // 3. User Avatars and Profile Photos
    match /avatars/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize(10 * 1024 * 1024);
    }

    // 4. Conversation Attachments & Voice Notes
    match /attachments/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize(50 * 1024 * 1024);
      allow delete: if isAuthenticated();
    }

    // 5. Default rule for all authenticated users
    match /{allPaths=**} {
      allow read, write: if isAuthenticated() && isValidSize(50 * 1024 * 1024);
    }
  }
}
